azure_backend_resource_group  = "replace-with-existing-resource-group"
azure_backend_storage_account = "replace-with-existing-storage-account"
gcp_project_id                = "replace-with-unique-project-id"
gcp_project_name              = "replace-with-project-display-name"
gcp_billing_account_id        = "replace-with-billing-account-id"
gcp_service_account_name      = "github-actions-sa"
play_store_developer_id       = "replace-with-google-play-developer-id"

# Create a Cloudflare API token with Zone:Read and DNS:Edit for only the zone(s) managed by this repository.
# The token is written to the GitHub Actions secret CLOUDFLARE_API_TOKEN.
cloudflare_api_token = "replace-with-cloudflare-api-token"