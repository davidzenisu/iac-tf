azure_backend_resource_group  = "replace-with-existing-resource-group"
azure_backend_storage_account = "replace-with-globally-unique-storage-name"
azure_key_vault_name          = "replace-with-kv-name"
azure_location                = "westeurope"
gcp_project_id                = "replace-with-unique-project-id"
gcp_project_name              = "replace-with-project-display-name"
gcp_billing_account_id        = "replace-with-billing-account-id"
gcp_service_account_name      = "github-actions-sa"
play_store_developer_id       = "replace-with-google-play-developer-id"
auth0_domain                  = "replace-with-auth0-domain"

# Manually create a Cloudflare API token with Zone:Read and DNS:Edit
# permissions limited to the zone(s) managed by this repository.
# https://dash.cloudflare.com/profile/api-tokens
# This token is written to GitHub Actions and Key Vault.
cloudflare_api_token = "replace-with-cloudflare-api-token"

# Manually create a Supabase personal access token.
# https://supabase.com/dashboard/account/tokens
supabase_access_token = "replace-with-supabase-personal-access-token"